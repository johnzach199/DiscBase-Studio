{
  "name": "discbase-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Album & Song Catalog Workstation with XLSX import/export and MySQL Server integration.",
  "author": "DiscBase Studio <support@discbase.local>",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "build:electron": "vite build && node -e \"const fs=require('fs');fs.mkdirSync('dist-server',{recursive:true});fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','server/sql-wasm.wasm');fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','dist-server/sql-wasm.wasm');\" && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:electron --outfile=dist-server/server.cjs",
    "start": "NODE_ENV=production node dist-server/server.mjs",
    "preview": "vite preview",
    "test": "tsx --test src/utils/catalogMath.test.ts",
    "clean": "rm -rf dist dist-server dist-electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.17.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
